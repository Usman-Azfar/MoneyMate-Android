<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="@string/title_statistics"
        app:titleTextColor="@color/on_surface"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/outline_variant"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Period selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/label_select_period"
                android:textAppearance="@style/TextAppearance.App.LabelSmall"
                android:textColor="@color/on_surface_variant" />

            <Spinner
                android:id="@+id/periodSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_16"
                android:background="@drawable/bg_field_outline"
                android:minHeight="@dimen/tap_target_min"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12" />

            <!-- Cycle picker: which specific week/month/year this budget applies to. Hidden for
                 DAILY, which always tracks "today" live with no date input. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cyclePickerLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_16"
                android:hint="@string/label_week_start_date"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_s"
                app:boxCornerRadiusTopEnd="@dimen/radius_s"
                app:boxCornerRadiusBottomStart="@dimen/radius_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cyclePickerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:textColor="@color/on_surface" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- End date: only shown for the Custom Duration period -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/customEndPickerLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_16"
                android:visibility="gone"
                android:hint="@string/label_end_date"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_s"
                app:boxCornerRadiusTopEnd="@dimen/radius_s"
                app:boxCornerRadiusBottomStart="@dimen/radius_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/customEndPickerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:textColor="@color/on_surface" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ask MoneyMate AI: questions about the period selected just above. Hidden in a
                 build with no Gemini key (see StatisticsActivity). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiAdvisorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/primary_container"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ai_advisor"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium"
                        android:textColor="@color/on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/label_ai_advisor_desc"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aiAdvisorBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        android:text="@string/btn_ask_ai"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/radius_pill" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Period summary (All Time / Custom Duration): budgets don't apply to these two
                 since they aren't recurring cycles, so just show income/expense/net for the
                 chosen window instead of the budget comparison card below. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/periodSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_16"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/stroke_hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_income_amount"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/periodSummaryIncomeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/placeholder_amount"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="@color/income" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/stroke_hairline"
                        android:layout_height="match_parent"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_total_expense"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/periodSummaryExpenseText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/placeholder_amount"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="@color/expense" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/stroke_hairline"
                        android:layout_height="match_parent"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_savings"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/periodSummaryNetText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/placeholder_amount"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="@color/on_surface" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/budgetUnavailableText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_8"
                android:visibility="gone"
                android:text="@string/msg_budget_unavailable_for_period"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/on_surface_variant" />

            <!-- Budget comparison card (visible once a budget is set for the selected period) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/comparisonCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_16"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/stroke_hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/space_20">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_on_track"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textColor="@color/income" />

                    <TextView
                        android:id="@+id/actualSpentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_amount"
                        android:textAppearance="@style/TextAppearance.App.DisplayLarge"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_actual_spent"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_surface_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal"
                        android:background="@color/surface_variant">

                        <View
                            android:id="@+id/budgetBarFill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0"
                            android:background="@color/income" />

                        <View
                            android:id="@+id/budgetBarEmpty"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/label_income_amount"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/incomeAmountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/income" />

                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/label_expected_spend"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/expectedSpendText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@color/outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/label_remaining"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/remainingText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/label_savings"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/savingsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/budgetPromptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_16"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="@color/on_surface_variant"
                tools:text="No monthly budget set yet." />

            <!-- Budget setup / edit form -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/incomeAmountInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:enabled="false"
                android:hint="@string/label_income_amount_auto"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_s"
                app:boxCornerRadiusTopEnd="@dimen/radius_s"
                app:boxCornerRadiusBottomStart="@dimen/radius_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/incomeAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:textColor="@color/on_surface" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/expectedSpendInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_16"
                android:hint="@string/label_expected_spend"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="@dimen/radius_s"
                app:boxCornerRadiusTopEnd="@dimen/radius_s"
                app:boxCornerRadiusBottomStart="@dimen/radius_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expectedSpendInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:textColor="@color/on_surface" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/saveBudgetBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_16"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                android:text="@string/btn_save_budget"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_s" />

            <!-- Category breakdown -->
            <TextView
                android:id="@+id/categoryBreakdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/label_category_breakdown"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="@color/on_surface"
                android:visibility="gone" />

            <com.yourname.expensetrackerapp.DonutChartView
                android:id="@+id/donutChart"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/space_20"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:orientation="vertical" />

            <!-- Outstanding debts for the selected period, shown alongside Income/Expense
                 breakdown above for the same consistency the rest of the app follows. -->
            <TextView
                android:id="@+id/outstandingDebtsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/label_outstanding_debts"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="@color/on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/outstandingDebtsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/stroke_hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_payable"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/statsPayableText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/expense" />

                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_receivable"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/statsReceivableText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/placeholder_amount"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/income" />

                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/outline_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_overdue_count"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/on_surface_variant" />

                            <TextView
                                android:id="@+id/statsOverdueCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
