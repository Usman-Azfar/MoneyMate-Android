<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editDescriptionInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_description"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editAmountInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/hint_amount"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editDateInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/hint_date"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/editTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/editRadioIncome"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_target_min"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_toggle_income"
                android:gravity="center"
                android:text="@string/radio_income"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/text_toggle_income" />

            <RadioButton
                android:id="@+id/editRadioExpense"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_target_min"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_toggle_expense_middle"
                android:gravity="center"
                android:text="@string/radio_expense"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/text_toggle_expense" />

            <RadioButton
                android:id="@+id/editRadioDebt"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_target_min"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_toggle_debt"
                android:gravity="center"
                android:text="@string/radio_debt"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/text_toggle_debt" />

        </RadioGroup>

        <Spinner
            android:id="@+id/editCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_field_outline"
            android:minHeight="@dimen/tap_target_min"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12" />

        <RadioGroup
            android:id="@+id/editDebtDirectionGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/editRadioDebtPayable"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_target_min"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_toggle_expense"
                android:gravity="center"
                android:text="@string/radio_payable"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/text_toggle_expense" />

            <RadioButton
                android:id="@+id/editRadioDebtReceivable"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_target_min"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_toggle_income"
                android:gravity="center"
                android:text="@string/radio_receivable"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/text_toggle_income" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editPersonNameInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone"
            android:hint="@string/hint_payable_to"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPersonNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editDueDateInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone"
            android:hint="@string/hint_due_date"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDueDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/editSettledCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone"
            android:text="@string/label_settled"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColor="@color/on_surface" />

    </LinearLayout>

</ScrollView>
