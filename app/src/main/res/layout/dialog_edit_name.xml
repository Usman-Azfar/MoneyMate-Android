<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingEnd="@dimen/space_24"
    android:paddingTop="@dimen/space_8"
    android:paddingBottom="@dimen/space_8">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/editNameInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_display_name"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="@dimen/radius_s"
        app:boxCornerRadiusTopEnd="@dimen/radius_s"
        app:boxCornerRadiusBottomStart="@dimen/radius_s"
        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColor="@color/on_surface" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
