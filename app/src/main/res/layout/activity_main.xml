<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="@dimen/elevation_raised"
        app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- A real child of the Toolbar (not a sibling) — the toolbar's own elevation makes its
             opaque gradient background paint over any same-level sibling regardless of XML
             order, so the brand chip + subtitle have to live inside the toolbar's own view tree
             to render on top of it at all. Replaces app:title/app:subtitle, which can only show
             plain single-color text and can't host the two-tone chip (see BrandName.kt). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/toolbarBrandText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brand_chip"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_4"
                android:textAppearance="@style/ToolbarTitleStyle"
                tools:text="MoneyMate" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/label_home_subtitle"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/on_hero_card"
                android:gravity="center" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:id="@+id/ScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/LinearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero balance card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/CardView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_16"
                android:background="@drawable/bg_hero_card"
                android:elevation="@dimen/elevation_raised"
                android:padding="@dimen/space_24">

                <FrameLayout
                    android:id="@+id/heroBadge"
                    android:layout_width="@dimen/badge_size_m"
                    android:layout_height="@dimen/badge_size_m"
                    android:background="@drawable/bg_badge_circle_translucent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="$"
                        android:textColor="@color/on_hero_card"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/TotalBalance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/label_total_balance"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/on_hero_card"
                    android:alpha="0.8"
                    app:layout_constraintTop_toBottomOf="@id/heroBadge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/Balance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/placeholder_amount"
                    android:textAppearance="@style/TextAppearance.App.DisplayLarge"
                    android:textColor="@color/on_hero_card"
                    app:layout_constraintTop_toBottomOf="@id/TotalBalance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/LinearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/incomeCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/income_container"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="@dimen/elevation_card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:id="@+id/incomeBadge"
                        android:layout_width="@dimen/badge_size_s"
                        android:layout_height="@dimen/badge_size_s"
                        android:background="@drawable/bg_badge_circle_income"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_down_left"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/totalIncome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_total_income"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/incomeBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalIncomeBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_amount"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/totalIncome"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalIncomeTransactions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_transaction_count"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/totalIncomeBalance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/expenseCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/expense_container"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="@dimen/elevation_card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:id="@+id/expenseBadge"
                        android:layout_width="@dimen/badge_size_s"
                        android:layout_height="@dimen/badge_size_s"
                        android:background="@drawable/bg_badge_circle_expense"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_up_right"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/totalExpense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_total_expense"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/expenseBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalExpenseBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_amount"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/totalExpense"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalExpenseTransactions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_transaction_count"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/totalExpenseBalance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/debtSummaryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payableCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/expense_container"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="@dimen/elevation_card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:id="@+id/payableBadge"
                        android:layout_width="@dimen/badge_size_s"
                        android:layout_height="@dimen/badge_size_s"
                        android:background="@drawable/bg_badge_circle_expense"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_up_right"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/totalPayableLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_total_payable"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/payableBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalPayableBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_amount"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/totalPayableLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalPayableCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_transaction_count"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_expense_container"
                        app:layout_constraintTop_toBottomOf="@id/totalPayableBalance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/space_12"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/receivableCardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/income_container"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="@dimen/elevation_card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_16">

                    <FrameLayout
                        android:id="@+id/receivableBadge"
                        android:layout_width="@dimen/badge_size_s"
                        android:layout_height="@dimen/badge_size_s"
                        android:background="@drawable/bg_badge_circle_income"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_down_left"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/totalReceivableLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/label_total_receivable"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/receivableBadge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalReceivableBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_amount"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/totalReceivableLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/totalReceivableCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/placeholder_transaction_count"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        android:textColor="@color/on_income_container"
                        app:layout_constraintTop_toBottomOf="@id/totalReceivableBalance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:id="@+id/overdueDebtText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone"
                android:gravity="center"
                android:background="@drawable/bg_field_outline"
                android:padding="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="@color/expense"
                tools:text="⚠ 2 debts overdue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_16"
                    android:text="@string/label_add_transaction"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:textColor="@color/on_surface" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="@dimen/tap_target_min"
                    android:layout_height="@dimen/tap_target_min"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_voice_input"
                    android:padding="@dimen/space_12"
                    android:src="@drawable/ic_mic" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/stroke_hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Type: choose Income / Expense / Debt first — the rest of the form
                         adapts to whichever is selected. -->
                    <RadioGroup
                        android:id="@+id/TypeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/RadioTypeIncome"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tap_target_min"
                            android:layout_weight="1"
                            android:button="@null"
                            android:background="@drawable/bg_toggle_income"
                            android:gravity="center"
                            android:text="@string/radio_income"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_toggle_income" />

                        <RadioButton
                            android:id="@+id/RadioTypeExpense"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tap_target_min"
                            android:layout_weight="1"
                            android:button="@null"
                            android:background="@drawable/bg_toggle_expense_middle"
                            android:gravity="center"
                            android:text="@string/radio_expense"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_toggle_expense" />

                        <RadioButton
                            android:id="@+id/RadioTypeDebt"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tap_target_min"
                            android:layout_weight="1"
                            android:button="@null"
                            android:background="@drawable/bg_toggle_debt"
                            android:gravity="center"
                            android:text="@string/radio_debt"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_toggle_debt" />

                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/descriptionInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:hint="@string/hint_description"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/radius_s"
                        app:boxCornerRadiusTopEnd="@dimen/radius_s"
                        app:boxCornerRadiusBottomStart="@dimen/radius_s"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/Description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge"
                            android:textColor="@color/on_surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/amountInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="@string/hint_amount"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/radius_s"
                        app:boxCornerRadiusTopEnd="@dimen/radius_s"
                        app:boxCornerRadiusBottomStart="@dimen/radius_s"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/Amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge"
                            android:textColor="@color/on_surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dateInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="@string/hint_date"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/radius_s"
                        app:boxCornerRadiusTopEnd="@dimen/radius_s"
                        app:boxCornerRadiusBottomStart="@dimen/radius_s"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconTint="@color/on_surface_variant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/DateInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge"
                            android:textColor="@color/on_surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Income / Expense category (hidden for Debt) -->
                    <Spinner
                        android:id="@+id/Spinner1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_field_outline"
                        android:minHeight="@dimen/tap_target_min"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12"
                        android:popupBackground="@color/surface" />

                    <!-- Debt direction — Payable (I owe) or Receivable (owed to me) -->
                    <RadioGroup
                        android:id="@+id/DebtDirectionGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/RadioDebtPayable"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tap_target_min"
                            android:layout_weight="1"
                            android:button="@null"
                            android:background="@drawable/bg_toggle_expense"
                            android:gravity="center"
                            android:text="@string/radio_payable"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_toggle_expense" />

                        <RadioButton
                            android:id="@+id/RadioDebtReceivable"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/tap_target_min"
                            android:layout_weight="1"
                            android:button="@null"
                            android:background="@drawable/bg_toggle_income"
                            android:gravity="center"
                            android:text="@string/radio_receivable"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_toggle_income" />

                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/personNameInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:visibility="gone"
                        android:hint="@string/hint_payable_to"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/radius_s"
                        app:boxCornerRadiusTopEnd="@dimen/radius_s"
                        app:boxCornerRadiusBottomStart="@dimen/radius_s"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/PersonNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge"
                            android:textColor="@color/on_surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dueDateInputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:visibility="gone"
                        android:hint="@string/hint_due_date"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/radius_s"
                        app:boxCornerRadiusTopEnd="@dimen/radius_s"
                        app:boxCornerRadiusBottomStart="@dimen/radius_s"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconTint="@color/on_surface_variant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/DueDateInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge"
                            android:textColor="@color/on_surface" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/AddTransactionBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="@dimen/space_16"
                        app:backgroundTint="@color/income"
                        android:textColor="@color/on_income"
                        android:text="@string/btn_add_income"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        app:icon="@drawable/ic_plus"
                        app:iconTint="@null"
                        app:iconGravity="textStart"
                        app:cornerRadius="@dimen/radius_m" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/RecentTransactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/label_recent_transactions"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="@color/on_surface" />

            <!-- FrameLayout to overlay empty state on RecyclerView. The RecyclerView is a fixed
                 height (~2 cards) rather than wrap_content, so with more than 2 recent
                 transactions it scrolls internally instead of pushing the rest of the page down. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/recent_transactions_height"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/recent_transactions_height"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Transactions will appear here!"
                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="gone"
                    android:padding="@dimen/space_20" />

            </FrameLayout>

            <Button
                android:id="@+id/ViewAllBtn"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/btn_view_all"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textAllCaps="false"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="@dimen/space_4" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
