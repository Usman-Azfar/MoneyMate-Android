<?xml version="1.0" encoding="utf-8"?>
<!-- Ask MoneyMate AI dialog. The whole content scrolls as one piece (rather than a scrolling
     answer area inside a fixed dialog), so a long answer never pushes the question box off-screen
     on small phones. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:id="@+id/aiPeriodText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/on_surface_variant" />

        <LinearLayout
            android:id="@+id/aiMessagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/aiSuggestionsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/label_ai_try_asking"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/aiSuggestionsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/aiQuestionLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/hint_ai_question"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:boxCornerRadiusTopStart="@dimen/radius_m"
            app:boxCornerRadiusTopEnd="@dimen/radius_m"
            app:boxCornerRadiusBottomStart="@dimen/radius_m"
            app:boxCornerRadiusBottomEnd="@dimen/radius_m">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/aiQuestionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:maxLines="4"
                android:imeOptions="actionSend"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="@color/on_surface" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/aiProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/aiStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aiAskBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                android:text="@string/btn_ai_ask"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_pill" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/label_ai_privacy_note"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/on_surface_variant" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
