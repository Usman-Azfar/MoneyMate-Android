    <!-- User guide -->
    <string name="title_user_guide">User Guide</string>
    <string name="guide_title_add">Adding a Transaction</string>
    <string name="guide_body_add">On the Home screen, first choose Income, Expense or Debt at the top of the form — the rest of the fields adapt to your choice. Fill in the details, then tap the Add button. The record date can be backdated but never set in the future.</string>
    <string name="guide_title_edit">Editing &amp; Deleting</string>
    <string name="guide_body_edit">Every transaction in Transaction History has Edit and Delete buttons. Home\'s recent-transactions preview only offers Delete — open History for full editing.</string>
    <string name="guide_title_history">History &amp; Filters</string>
    <string name="guide_body_history">History lists every transaction. Use the search icon to find one by description, or the filter icon to narrow by type or date range.</string>
    <string name="guide_title_statistics">Statistics &amp; Budgets</string>
    <string name="guide_body_statistics">Pick a Daily, Weekly, Monthly or Yearly period, set an expected spend, and Statistics compares it against your actual spending with a category breakdown chart.</string>
    <string name="guide_title_categories">Categories</string>
    <string name="guide_body_categories">Manage your own Income and Expense categories from Settings — add new ones or remove ones you no longer use. Past transactions keep their original category even if it\'s later removed.</string>
    <string name="guide_title_currency">Currency</string>
    <string name="guide_body_currency">Pick your preferred currency in Settings. This only changes the symbol shown throughout the app and reports — it does not convert past amounts.</string>
    <string name="guide_title_notifications">Notifications &amp; Budget Alerts</string>
    <string name="guide_body_notifications">You\'ll get an alert if a budget is exceeded, or if spending exceeds income in a cycle. Turn these off anytime from Settings.</string>
    <string name="guide_title_sync">Offline &amp; Sync</string>
    <string name="guide_body_sync">The app works fully offline — changes are saved locally and automatically synced to the cloud once you\'re back online. You can also trigger a manual sync from Settings.</string>
    <string name="guide_title_debts">Tracking Debts</string>
    <string name="guide_body_debts">Choose Debt on Home to record money you owe (Payable) or money owed to you (Receivable), along with the other person\'s name and a due date. Outstanding debts show on Home and in Statistics, turn red once overdue, and can be checked off as Settled from History or Home once paid or collected. Debts never affect your Total Balance — only settled income and expenses do.</string>
